# Risk API (FastAPI app.main:app) — local or Fly secrets
MODE=paper
API_HOST=0.0.0.0
API_PORT=8000
# Required because this example binds beyond loopback.
API_TOKEN=
API_CORS_ORIGINS=https://polymarket-quant-bot-lite.lovable.app,http://localhost:5173,http://localhost:3000
APP_DATABASE_URL=sqlite:////data/app.db
RISK_ENGINE_ENABLED=true
CLOB_PRICE_FEED_ENABLED=false

# Leaderboard adapter (public Polymarket data API)
LEADERBOARD_CATEGORY=OVERALL
LEADERBOARD_TIME_PERIOD=ALL
LEADERBOARD_ORDER_BY=PNL
LEADERBOARD_LIMIT=50
LEADERBOARD_ENRICH_HISTORY=true

# Frontend (Lovable / Vite) — set on the UI host, not only on Fly
# VITE_API_URL=https://polymarket-quant-risk.fly.dev
# Do not put API_TOKEN in VITE_* variables; browser bundles are public.
