{
  "title": "Polymarket Quant Bot",
  "uid": "polymarket-quant-bot",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Daily PnL (USD)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "bot_daily_pnl_usd", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Kill switch active",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "bot_kill_switch_active", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK" }, "1": { "text": "KILLED" } } }
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Intents / min by side",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum by (side) (rate(bot_intents_total[5m]))*60", "legendFormat": "{{side}}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Blocked intents / min by reason",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "sum by (reason_kind) (rate(bot_intents_blocked_total[5m]))*60", "legendFormat": "{{reason_kind}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Fill USD notional / hour",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "sum by (dry_run) (rate(bot_fill_usd_total[1h]))*3600", "legendFormat": "dry_run={{dry_run}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Outcomes by winner (cumulative)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "bot_outcomes_total", "legendFormat": "{{winner}}", "refId": "A" }
      ]
    }
  ]
}
