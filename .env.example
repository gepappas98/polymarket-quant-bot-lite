# === MODE (Nexus-style double opt-in for live) ===
MODE=paper
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK

# === AUTH (live only) ===
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# === MARKETS ===
ASSETS=BTC
WINDOWS=5,15

# === RISK ===
MAX_ORDER_USD=25
MAX_MARKET_EXPOSURE_USD=150
ARB_THRESHOLD=0.985
MIN_DIRECTIONAL_EDGE=0.03
PREFER_MAKER=true
DAILY_LOSS_LIMIT_USD=-200
COOLDOWN_MINUTES=3
MIN_TRACK_RECORD_WIN_PCT=48
MIN_TRACK_RECORD_SAMPLES=12

# === PORTFOLIO PROTECTIONS (Nexus-style) ===
# Low-profit pair lock: after N consecutive settled outcomes for the same
# market net <= threshold, lock that market out for a cooldown window.
# DAILY_LOSS_LIMIT_USD above doubles as the max-drawdown kill-switch limit.
PAIR_LOCK_LOOKBACK=5
PAIR_LOCK_LOSS_THRESHOLD_USD=0
PAIR_LOCK_MINUTES=30

# === NETWORK ===
HTTP_TIMEOUT=6
HTTP_RETRIES=3
LOG_LEVEL=INFO
# LOG_FORMAT=json   # default is human-readable text; set json for structured logs
# ENABLE_METRICS=true   # exposes GET /metrics (Prometheus text format) alongside /status

# LEDGER_PATH=data/trades.jsonl
# OUTCOMES_PATH=data/outcomes.jsonl

# === DASHBOARD BRIDGE ===
# Set to expose a JSON status endpoint at GET /status for the dashboard
# (polymarket-quant-bot-lite frontend's BOT_STATUS_URL). Leave unset to disable.
# STATUS_PORT=8080

# === STRATEGY PLUGINS (bot/strategies/) ===
# Every plugin below is off by default and auto-discovered by
# bot/strategies/loader.py — no code changes needed to enable one.
# The core arb/directional strategy (bot/strategies/arbitrage.py) always runs.

# --- Market making (bot/strategies/market_making.py) ---
# Two-sided quoting around fair value with inventory skew.
MM_ENABLED=false
MM_HALF_SPREAD=0.02
MM_MAX_SKEW_INVENTORY_USD=60
MM_SKEW_STRENGTH=0.05
MM_QUOTE_SIZE_USD=10
MM_REQUOTE_INTERVAL_SEC=6

# --- Copy trading (bot/strategies/copy_trading.py) ---
# Replicates tracked wallets' Polymarket buys via the public Data API.
COPY_TRADING_ENABLED=false
COPY_TRADING_WALLETS=
COPY_TRADING_SIZE_MULTIPLIER=0.1
COPY_TRADING_MIN_TRADE_USD=20
COPY_TRADING_POLL_INTERVAL_SEC=15
COPY_TRADING_MAX_TRADE_AGE_SEC=120
# POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com

# --- ML directional (bot/strategies/ml_directional.py) ---
# XGBoost win-probability model + fractional Kelly sizing. Requires a
# trained model — see the "Backtesting" section of README.md.
ML_STRATEGY_ENABLED=false
# ML_MODEL_PATH=data/ml_model.json
ML_MIN_CONFIDENCE_EDGE=0.08
ML_KELLY_FRACTION=0.4

# --- Cross-venue signal — Polymarket vs Kalshi (bot/strategies/cross_platform_arbitrage.py) ---
# Directional signal only — trades the Polymarket leg, does not execute on
# Kalshi (no hedge). Requires a Kalshi API key pair (RSA-PSS signing).
KALSHI_ARB_ENABLED=false
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_API_HOST=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_MARKET_MAP={"btc-updown-5m-...": "KXBTC-..."}   # inline JSON or a path to a JSON file
KALSHI_ARB_MIN_GAP=0.04
KALSHI_ARB_QUOTE_SIZE_USD=15
KALSHI_ARB_POLL_INTERVAL_SEC=10

# === PERSISTED DAILY KILL SWITCH (bot/daily_limit.py) ===
# Same file survives process restarts within the same UTC day, so
# DAILY_LOSS_LIMIT_USD (above) doesn't "forget" losses on redeploy.
# DAILY_LIMIT_STATE_PATH=data/daily_pnl.json

# === POSTGRESQL LEDGER (optional, bot/ledger_pg.py) ===
# Drop-in replacement for the JSONL ledger. Falls back to JSONL with a
# logged error if the driver or DATABASE_URL is missing.
# pip install "psycopg[binary]>=3.1.0" psycopg_pool
# LEDGER_BACKEND=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/polymarket_bot

# === PROMETHEUS METRICS (optional, bot/metrics.py) ===
# pip install prometheus-client
# Separate from ENABLE_METRICS above — this is a fuller prometheus_client
# exporter on its own port; pairs with deploy/docker-compose.monitoring.yml.
# PROMETHEUS_PORT=9108
