# === MODE (Nexus-style double opt-in for live) ===
MODE=paper
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK

# === AUTH (live only) ===
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# === MARKETS ===
ASSETS=BTC
WINDOWS=5,15

# === RISK ===
MAX_ORDER_USD=25
MAX_MARKET_EXPOSURE_USD=150
ARB_THRESHOLD=0.985
MIN_DIRECTIONAL_EDGE=0.03
PREFER_MAKER=true
DAILY_LOSS_LIMIT_USD=-200
COOLDOWN_MINUTES=3
MIN_TRACK_RECORD_WIN_PCT=48
MIN_TRACK_RECORD_SAMPLES=12

# === PORTFOLIO PROTECTIONS (Nexus-style) ===
# Low-profit pair lock: after N consecutive settled outcomes for the same
# market net <= threshold, lock that market out for a cooldown window.
# DAILY_LOSS_LIMIT_USD above doubles as the max-drawdown kill-switch limit.
PAIR_LOCK_LOOKBACK=5
PAIR_LOCK_LOSS_THRESHOLD_USD=0
PAIR_LOCK_MINUTES=30

# === NETWORK ===
HTTP_TIMEOUT=6
HTTP_RETRIES=3
LOG_LEVEL=INFO
# LOG_FORMAT=json   # default is human-readable text; set json for structured logs
# ENABLE_METRICS=true   # exposes GET /metrics (Prometheus text format) alongside /status

# LEDGER_PATH=data/trades.jsonl
# OUTCOMES_PATH=data/outcomes.jsonl

# === MARKET MAKING (off by default) ===
MM_ENABLED=false
MM_HALF_SPREAD=0.02
MM_MAX_SKEW_INVENTORY_USD=60
MM_SKEW_STRENGTH=0.05
MM_QUOTE_SIZE_USD=10
MM_REQUOTE_INTERVAL_SEC=6

# === COPY TRADING (off by default) ===
COPY_TRADING_ENABLED=false
COPY_TRADING_WALLETS=
COPY_TRADING_SIZE_MULTIPLIER=0.1
COPY_TRADING_MIN_TRADE_USD=20
COPY_TRADING_POLL_INTERVAL_SEC=15
COPY_TRADING_MAX_TRADE_AGE_SEC=120
POLYMARKET_DATA_API_HOST=https://data-api.polymarket.com

# === DAILY KILL SWITCH PERSISTENCE ===
# Same file survives process restarts within the same UTC day, so the
# daily_loss_limit_usd kill switch above doesn't "forget" losses on redeploy.
DAILY_LIMIT_STATE_PATH=data/daily_pnl.json

# === DASHBOARD BRIDGE ===
# Set to expose a JSON status endpoint at GET /status for the dashboard
# (polymarket-quant-bot-lite frontend's BOT_STATUS_URL). Leave unset to disable.
# STATUS_PORT=8080
